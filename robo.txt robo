// Declarando potenciômetro (opcional)
#define pot A0
int velocidade;

// Sensores
#define sensor1 12
#define sensor2 8
#define sensor3 2
#define sensor4 4
#define sensor5 7

// Motores
#define MA_frente 11
#define MA_tras 10
#define MB_frente 5
#define MB_tras 6

void setup() {
  Serial.begin(9600);

  // Configura sensores como entrada
  pinMode(sensor1, INPUT);
  pinMode(sensor2, INPUT);
  pinMode(sensor3, INPUT);
  pinMode(sensor4, INPUT);
  pinMode(sensor5, INPUT);

  // Configura motores como saída
  pinMode(MA_frente, OUTPUT);
  pinMode(MA_tras, OUTPUT);
  pinMode(MB_frente, OUTPUT);
  pinMode(MB_tras, OUTPUT);
}

void loop() {
  // Leitura da velocidade (pode substituir por analogRead(pot) se quiser usar potenciômetro)
  velocidade = 30; // valor entre 0 e 255

  // Leitura dos sensores (inverte lógica se linha for preta)
  bool s1 = !digitalRead(sensor1);
  bool s2 = !digitalRead(sensor2);
  bool s3 = !digitalRead(sensor3);
  bool s4 = !digitalRead(sensor4);
  bool s5 = !digitalRead(sensor5);

  // Debug no Serial Monitor
  Serial.print(s1); Serial.print(" ");
  Serial.print(s2); Serial.print(" ");
  Serial.print(s3); Serial.print(" ");
  Serial.print(s4); Serial.print(" ");
  Serial.println(s5);

  // Movimento para frente (linha no centro)
  if (s3 && !s2 && !s4) {
    mover(velocidade, velocidade);
  }
  // Curva suave para esquerda
  else if (s2 && !s1) {
    mover(velocidade / 2, velocidade);
  }
  // Curva suave para direita
  else if (s4 && !s5) {
    mover(velocidade, velocidade / 2);
  }
  // Curva forte para esquerda
  else if (s1) {
    girarEsquerda(velocidade);
  }
  // Curva forte para direita
  else if (s5) {
    girarDireita(velocidade);
  }
  // Nenhum sensor detectando linha: para
  else {
    parar();
  }

  delay(10);
}

// Funções auxiliares
void mover(int velA, int velB) {
  analogWrite(MA_frente, velA);
  analogWrite(MA_tras, 0);
  analogWrite(MB_frente, velB);
  analogWrite(MB_tras, 0);
}

void girarEsquerda(int vel) {
  analogWrite(MA_frente, 0);
  analogWrite(MA_tras, vel);
  analogWrite(MB_frente, vel);
  analogWrite(MB_tras, 0);
}

void girarDireita(int vel) {
  analogWrite(MA_frente, vel);
  analogWrite(MA_tras, 0);
  analogWrite(MB_frente, 0);
  analogWrite(MB_tras, vel);
}

void parar() {
  analogWrite(MA_frente, 0);
  analogWrite(MA_tras, 0);
  analogWrite(MB_frente, 0);
  analogWrite(MB_tras, 0);
}












































const int in1 = 11; 
const int in2 = 10; 
const int in3 = 5; 
const int in4 = 6; 

const int sensor1 = 12; 
const int sensor2 = 8;
const int sensor3 = 2;
const int sensor4 = 4;
const int sensor5 = 7; 

const int velocidade = 30;

void setup() {
  pinMode(in1, OUTPUT); 
  pinMode(in2, OUTPUT); 
  pinMode(in3, OUTPUT); 
  pinMode(in4, OUTPUT); 

  pinMode(sensor1, INPUT); 
  pinMode(sensor2, INPUT);
  pinMode(sensor3, INPUT);
  pinMode(sensor4, INPUT);
  pinMode(sensor5, INPUT);
}

void loop() {
  int s1 = digitalRead(sensor1); 
  int s2 = digitalRead(sensor2); 
  int s3 = digitalRead(sensor3); 
  int s4 = digitalRead(sensor4); 
  int s5 = digitalRead(sensor5); 

  // Prioridade para o sensor central
  if (s3 == LOW && s2 == HIGH && s4 == HIGH) {
    andarParaFrente();
  }
  // Leve desvio à esquerda
  else if (s2 == LOW && s1 == HIGH) {
    corrigirLeveEsquerda();
  }
  // Leve desvio à direita
  else if (s4 == LOW && s5 == HIGH) {
    corrigirLeveDireita();
  }
  // Curva acentuada à esquerda
  else if (s1 == LOW) {
    virarEsquerda();
  }
  // Curva acentuada à direita
  else if (s5 == LOW) {
    virarDireita();
  }
  // Linha desaparecida (tudo branco)
  else {
    parar();
  }
}

void andarParaFrente() {
  analogWrite(in1, velocidade); 
  analogWrite(in2, 0); 
  analogWrite(in3, velocidade); 
  analogWrite(in4, 0); 
}

void corrigirLeveEsquerda() {
  analogWrite(in1, velocidade / 2);  // reduz motor esquerdo
  analogWrite(in2, 0); 
  analogWrite(in3, velocidade); 
  analogWrite(in4, 0); 
}

void corrigirLeveDireita() {
  analogWrite(in1, velocidade); 
  analogWrite(in2, 0); 
  analogWrite(in3, velocidade / 2);  // reduz motor direito
  analogWrite(in4, 0); 
}

void virarEsquerda() {
  analogWrite(in1, 0); 
  analogWrite(in2, velocidade); 
  analogWrite(in3, velocidade); 
  analogWrite(in4, 0); 
}

void virarDireita() {
  analogWrite(in1, velocidade); 
  analogWrite(in2, 0); 
  analogWrite(in3, 0); 
  analogWrite(in4, velocidade); 
}

void parar() {
  analogWrite(in1, 0); 
  analogWrite(in2, 0); 
  analogWrite(in3, 0); 
  analogWrite(in4, 0); 
}
